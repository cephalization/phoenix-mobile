    "ios:device": "expo run:ios --device",
    "ios:device:clean": "./scripts/rebuild-ios-device.sh",
    "web": "expo start --web",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/render-app-icons.mts",
    "check": "vp check && vp test run"
