{
  "name": "phoenix-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "android:device": "./scripts/run-android-device.sh",
    "android:device:clean": "./scripts/rebuild-android-device.sh",
    "android:device:start": "./scripts/start-android-device.sh",
